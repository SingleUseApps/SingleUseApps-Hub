# Copy to .env and fill in. Never commit .env — this file is only a template.

PORT=4002

# Comma-separated list of frontend origins allowed to call this API.
# luisdanielsilva.com is temporary — that's where the Portal (with the Buy
# form) currently deploys; move to just the Hub/app domains once it migrates.
ALLOWED_ORIGINS=https://dupsweep.com,https://singleuseapps.com,https://luisdanielsilva.com,https://www.luisdanielsilva.com

# Minimum purchase amount in cents (500 = 5.00 EUR). Customers can pay more;
# Stripe's custom_unit_amount lets them raise it, never lower it.
MIN_PRICE_CENTS=500

# Stripe (test keys for now — https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=
# Generated when the webhook endpoint is registered in the Stripe dashboard
# (Developers -> Webhooks -> Add endpoint -> https://singleuseapps.com/api/webhooks/stripe)
STRIPE_WEBHOOK_SECRET=

# Resend (https://resend.com/api-keys)
RESEND_API_KEY=
RESEND_FROM=DupSweep <support@dupsweep.com>

# Per-app salts. Must match the salt embedded in each app's offline validator.
SALT_FILELISTER=
SALT_KNOCKAPP=
SALT_VISUALEXIF=
SALT_FILELISTERTAURI=
SALT_DUPSWEEP=

# Where the SQLite DB file lives.
DB_PATH=./data/licenses.db
